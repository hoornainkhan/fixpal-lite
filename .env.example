# FixPal Lite - Environment Configuration Example
# Copy this to .env and fill in your actual values

# NVIDIA API Key for LLM analysis
# Get free key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxx

# Optional: override the LLM model (default: meta/llama-3.1-70b-instruct)
# Only models provisioned for your NVIDIA account will respond.
# Confirm available models at https://build.nvidia.com
# NOTE: If a model is NOT provisioned, the NVIDIA server accepts the
# connection but never responds, which looks like an endless "loading" state.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional: request timeout in milliseconds (default: 150000 = 150s)
# NVIDIA_TIMEOUT_MS=150000

# Backend server port (optional, defaults to 8080)
PORT=8080
